# Copy to backend/.env (or export in your shell). Never commit the real file.
# xAI API key from https://console.x.ai  (API Keys page). Used for Grok labeling/summaries
# and, with DATA_SOURCE=xai_x_search, for retrieving X posts via Grok's built-in x_search tool.
XAI_API_KEY=
# Optional: official X API v2 bearer token (https://developer.x.com -> Projects & Apps -> Keys and tokens).
# Needed only for DATA_SOURCE=x_api_v2 (and enables the 7-day volume series for live topics).
X_BEARER_TOKEN=
# xai_x_search | x_api_v2 | auto   (auto = xai_x_search if XAI_API_KEY is set, else x_api_v2)
DATA_SOURCE=auto
# Models (OpenAI-compatible endpoint https://api.x.ai/v1)
GROK_SEARCH_MODEL=grok-4.7
GROK_LABEL_MODEL=grok-4.20-0309-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1
# Pipeline knobs (keep small to control API spend)
XAI_SEARCH_CALLS=3
LOOKBACK_DAYS=30
MAX_POSTS=200
LABEL_BATCH=20
